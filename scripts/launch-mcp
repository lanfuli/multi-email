#!/usr/bin/env node

import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const bundledEntry = path.join(pluginRoot, "dist", "server.cjs");
let runtimeModule;

try {
  runtimeModule = await import(
    new URL("../src/runtime-integrity.mjs", import.meta.url).href
  );
  const {
    installVerifiedRuntimeInfo,
    RuntimeIntegrityError,
    verifyRuntimeBundle,
  } = runtimeModule;
  const runtimeInfo = await verifyRuntimeBundle(pluginRoot);
  installVerifiedRuntimeInfo(runtimeInfo);
  const loaded = await import(pathToFileURL(bundledEntry).href);
  const startServer = loaded.startServer || loaded.default?.startServer;
  if (typeof startServer !== "function") {
    throw new RuntimeIntegrityError("BUNDLE_ENTRY_INVALID");
  }
  await startServer();
} catch (error) {
  const RuntimeIntegrityError = runtimeModule?.RuntimeIntegrityError;
  const safe = runtimeModule?.safeRuntimeFailure(
    RuntimeIntegrityError && error instanceof RuntimeIntegrityError
      ? error
      : RuntimeIntegrityError
        ? new RuntimeIntegrityError("BUNDLE_START_FAILED")
        : error,
  ) || {
    code: "RUNTIME_INTEGRITY_ERROR",
    reason: "RUNTIME_CHECK_FAILED",
    requiredAction: "reinstall_or_rebuild",
  };
  console.error(
    `[multi-email] ${safe.code}: ${safe.reason}. ${safe.requiredAction}.`,
  );
  process.exitCode = 1;
}
