#!/usr/bin/env node

import { existsSync } from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const bundledEntry = path.join(pluginRoot, "dist", "server.cjs");
const sourceEntry = path.join(pluginRoot, "src", "setup.mjs");
const entry = existsSync(bundledEntry) ? bundledEntry : sourceEntry;
const module = await import(pathToFileURL(entry).href);
const runSetup = module.runSetup || module.run;

if (typeof runSetup !== "function") {
  console.error("Multi Email setup entry is unavailable. Reinstall or rebuild the package.");
  process.exitCode = 1;
} else {
  runSetup(process.argv.slice(2)).catch((error) => {
    const code = error?.code ? ` [${error.code}]` : "";
    console.error(`Setup failed${code}: ${error?.message || "an unexpected error occurred"}`);
    process.exitCode = 1;
  });
}
