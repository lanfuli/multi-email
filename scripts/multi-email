#!/usr/bin/env node

import { existsSync } from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const pluginRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const bundledEntry = path.join(pluginRoot, "dist", "server.cjs");
const sourceEntry = path.join(pluginRoot, "src", "setup.mjs");
const entry = existsSync(bundledEntry) ? bundledEntry : sourceEntry;
let module;
try {
  module = await import(pathToFileURL(entry).href);
} catch {
  console.error("Multi Email setup could not be loaded. Reinstall or rebuild the package.");
  process.exitCode = 1;
}
const runSetupCli = module?.runSetupCli || module?.default?.runSetupCli;

if (module && typeof runSetupCli !== "function") {
  console.error("Multi Email setup entry is unavailable. Reinstall or rebuild the package.");
  process.exitCode = 1;
} else if (runSetupCli) {
  try {
    await runSetupCli(process.argv.slice(2));
  } catch {
    console.error("Setup failed: an unexpected local or provider error occurred.");
    process.exitCode = 1;
  }
}
